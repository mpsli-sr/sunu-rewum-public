'use client';
import { useEffect, useState } from 'react';
import Link from 'next/link';
import InlineEditor from '@/components/InlineEditor';
import EditableBlockRenderer from '@/components/EditableBlockRenderer';
import AcronymeDisplay from '@/components/AcronymeDisplay';
import SocialFooter from '@/components/SocialFooter';

export default function HomePage() {
  const [stats, setStats] = useState({ users: 0, posts: 0, events: 0 });
  const [newsletterEmail, setNewsletterEmail] = useState('');
  const [newsletterMsg, setNewsletterMsg] = useState('');
  const [heroTitle, setHeroTitle] = useState('SUNU REWUM'); // sans drapeau
  const [user, setUser] = useState<any>(null);
  // Logos
  const [logoHL, setLogoHL] = useState('');
  const [logoHR, setLogoHR] = useState('');
  const [logoFL, setLogoFL] = useState('');
  const [logoFR, setLogoFR] = useState('');
  const [logoPosition, setLogoPosition] = useState('');

 useEffect(() => {
    fetch('http://localhost:3001/api/public/stats')
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(setStats)
      .catch(() => {});
    fetch('http://localhost:3001/api/auth/me', { credentials: 'include' })
      .then(r => r.ok ? r.json() : null)
      .then(setUser)
      .catch(() => {});
    fetch('http://localhost:3001/api/site-settings')
      .then(r => r.ok ? r.json() : Promise.reject())
      .then(s => {
        const prefix = 'http://localhost:3001';
        if (s.siteTitle) setHeroTitle(s.siteTitle); // on garde le texte seul
        if (s.logoHeaderLeft) setLogoHL(s.logoHeaderLeft.startsWith('http') ? s.logoHeaderLeft : prefix + s.logoHeaderLeft);
        if (s.logoHeaderRight) setLogoHR(s.logoHeaderRight.startsWith('http') ? s.logoHeaderRight : prefix + s.logoHeaderRight);
        if (s.logoFooterLeft) setLogoFL(s.logoFooterLeft.startsWith('http') ? s.logoFooterLeft : prefix + s.logoFooterLeft);
        if (s.logoFooterRight) setLogoFR(s.logoFooterRight.startsWith('http') ? s.logoFooterRight : prefix + s.logoFooterRight);
        if (s.logoPosition) setLogoPosition(s.logoPosition);
      })
      .catch(() => {});
  }, []);

  const saveHeroTitle = async (val: string) => {
    setHeroTitle(val);
    await fetch('http://localhost:3001/api/site-settings', {
      method: 'PUT',
      credentials: 'include',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ siteTitle: val }),
    });
  };

  const subscribe = async () => {
    if (!newsletterEmail) return;
    const res = await fetch('http://localhost:3001/api/newsletter', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ email: newsletterEmail }),
    });
    if (res.ok) {
      setNewsletterMsg('Merci pour votre inscription !');
      setNewsletterEmail('');
    } else {
      setNewsletterMsg('Erreur lors de l\'inscription.');
    }
  };

  const positions = logoPosition ? logoPosition.split(',').filter(Boolean) : [];
  const showHeaderLeft = logoHL && positions.includes('header_left');
  const showHeaderRight = logoHR && positions.includes('header_right');
  const showFooterLeft = logoFL && positions.includes('footer_left');
  const showFooterRight = logoFR && positions.includes('footer_right');

  return (
    <div className="min-h-screen flex flex-col">
      {showHeaderRight && (
        <div className="fixed top-0 right-0 z-50 p-4">
          <img src={logoHR} alt="Logo droite" className="h-8 w-auto" />
        </div>
      )}

      <div className="bg-gradient-to-r from-green-700 to-yellow-600 text-white py-20 px-4">
        <div className="max-w-4xl mx-auto text-center">
         <div className="flex items-center justify-center gap-3 mb-4">
  {/* Drapeau fixe */}
  <span className="text-5xl md:text-6xl font-extrabold">{String.fromCodePoint(0x1F1F8, 0x1F1F3)}</span>
  {showHeaderLeft && (
    <img src={logoHL} alt="Logo gauche" style={{ height: '32px', width: 'auto' }} />
  )}
  <InlineEditor
    initialContent={heroTitle.replace(/^🇸🇳\s*/, '')} // retire le drapeau s'il existe
    onSave={async (val) => {
      const newTitle = `🇸🇳 ${val}`;
      setHeroTitle(newTitle);
      await fetch('http://localhost:3001/api/site-settings', {
        method: 'PUT',
        credentials: 'include',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ siteTitle: val }), // on sauvegarde sans le drapeau
      });
    }}
    role={user?.role}
    className="text-5xl md:text-6xl font-extrabold"
    as="h1"
  />
</div>
          <p className="text-2xl md:text-3xl mb-2">COTHIE AK M.P.S.L.I</p>
          <p className="text-xl mb-8">Travail, Dignité, Souveraineté, Solidarité</p>
          <AcronymeDisplay />
          <div className="flex flex-wrap justify-center gap-4">
            <Link href="/register" className="bg-white text-green-800 font-bold px-8 py-3 rounded-full hover:bg-gray-100">Adhérer</Link>
            <Link href="/donations" className="bg-yellow-400 text-gray-900 font-bold px-8 py-3 rounded-full hover:bg-yellow-300">Faire un don</Link>
            <Link href="/events" className="bg-red-600 text-white font-bold px-8 py-3 rounded-full hover:bg-red-500">Participer à un événement</Link>
          </div>
        </div>
      </div>

      <div className="max-w-4xl mx-auto -mt-10 grid grid-cols-3 gap-4 px-4">
        <div className="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 text-center">
          <p className="text-4xl font-bold text-green-700">{stats.users}</p>
          <p className="text-gray-500 dark:text-gray-300">Membres</p>
        </div>
        <div className="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 text-center">
          <p className="text-4xl font-bold text-yellow-600">{stats.posts}</p>
          <p className="text-gray-500 dark:text-gray-300">Propositions</p>
        </div>
        <div className="bg-white dark:bg-gray-800 rounded-xl shadow-lg p-6 text-center">
          <p className="text-4xl font-bold text-red-600">{stats.events}</p>
          <p className="text-gray-500 dark:text-gray-300">Événements</p>
        </div>
      </div>

      <div className="max-w-6xl mx-auto py-16 px-4">
        <h2 className="text-3xl font-bold text-center mb-12 text-gray-900 dark:text-white">Explorez le mouvement</h2>
        <div className="grid grid-cols-2 md:grid-cols-4 gap-6">
          {[
            { href: '/dashboard', icon: '📊', label: 'Tableau de bord' },
            { href: '/feed', icon: '📰', label: 'Actualités' },
            { href: '/program', icon: '📋', label: 'Programme 2029' },
            { href: '/proposals', icon: '💡', label: 'Propositions' },
            { href: '/diaspora', icon: '🌍', label: 'Diaspora' },
            { href: '/simulator', icon: '🏛', label: 'Simulateur' },
            { href: '/leaderboard', icon: '🏆', label: 'Classement' },
            { href: '/discover', icon: '🔍', label: 'Découvrir' },
          ].map(item => (
            <Link key={item.href} href={item.href}
              className="bg-white dark:bg-gray-800 rounded-xl shadow p-6 text-center hover:scale-105 transition-transform">
              <div className="text-3xl mb-2">{item.icon}</div>
              <h3 className="font-bold text-gray-900 dark:text-white">{item.label}</h3>
            </Link>
          ))}
        </div>
      </div>

      <EditableBlockRenderer page="home" />

      <div className="bg-gray-100 dark:bg-gray-800 py-12 px-4">
        <div className="max-w-md mx-auto text-center">
          <h3 className="text-2xl font-bold mb-4">Restez informé</h3>
          <p className="text-gray-600 dark:text-gray-300 mb-6">Recevez les dernières actualités du mouvement.</p>
          {newsletterMsg && <p className="text-green-600 mb-4">{newsletterMsg}</p>}
          <div className="flex gap-2">
            <input type="email" placeholder="votre@email.com" value={newsletterEmail} onChange={e => setNewsletterEmail(e.target.value)}
              className="flex-1 p-2 border rounded dark:bg-gray-700 dark:text-white" />
            <button onClick={subscribe} className="bg-green-700 text-white px-6 py-2 rounded hover:bg-green-800">S'abonner</button>
          </div>
        </div>
      </div>

      {(showFooterLeft || showFooterRight) && (
        <footer className="p-4 bg-white dark:bg-gray-800 border-t flex justify-between items-center">
          <div>{showFooterLeft && <img src={logoFL} alt="Logo bas gauche" className="h-6 w-auto" />}</div>
          <div>{showFooterRight && <img src={logoFR} alt="Logo bas droite" className="h-6 w-auto" />}</div>
        </footer>
      )}

      <SocialFooter />
    </div>
  );
}
